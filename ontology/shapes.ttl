@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vwm: <http://ontologie.politie.nl/def/vwm#> .
@prefix ui: <http://ontologie.politie.nl/def/ui#> .
@prefix dpm: <http://ontologie.politie.nl/def/dpm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vwm:PersoonsBeschrijvingShape a sh:NodeShape ;
  sh:targetClass vwm:PersoonsBeschrijving ;
  ui:buttonLabelRegister "Persoon" ;
  ui:buttonLabelAttach "PersoonBeschrijving" ;
  ui:sameIdentityActionLabel "Zelfde persoon" ;
  ui:alreadyLinkedLabel "Al gekoppeld via Verwijzing" ;
  sh:property [
    sh:path dpm:lastName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:path dpm:bsn ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:order 2 ;
    ui:primaryDisplayIdentifier true ;
  ] ;
  sh:property [
    sh:path dpm:birthDate ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
    sh:order 3 ;
  ] .

vwm:PersoonsBeschrijving vwm:isFindableInOtherCase true .
vwm:PersoonsBeschrijving vwm:searchProperty dpm:lastName .

vwm:ContactGegevensShape a sh:NodeShape ;
  sh:targetClass vwm:ContactGegevens ;
  sh:property [
    sh:path dpm:emailAddress ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:path dpm:telephoneNumber ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 2 ;
  ] .

vwm:AfhankelijkeTBShape a sh:NodeShape ;
  sh:targetClass vwm:AfhankelijkeTB ;
  sh:property [
    sh:path vwm:verwijstNaar ;
    sh:nodeKind sh:IRI ;
    sh:class vwm:ToestandsBeschrijving ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] .

vwm:IncidentBeschrijvingShape a sh:NodeShape ;
  sh:targetClass vwm:IncidentBeschrijving ;
  sh:property [
    sh:path dpm:location ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
    ui:primaryDisplayIdentifier true ;
    ui:primaryDisplayOrder 1 ;
  ] ;
  sh:property [
    sh:path dpm:timestamp ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:order 2 ;
    ui:primaryDisplayIdentifier true ;
    ui:primaryDisplayOrder 2 ;
    ui:primaryDisplayLabel "Tijd" ;
  ] .

vwm:OndernemingsBeschrijvingShape a sh:NodeShape ;
  sh:targetClass vwm:OndernemingsBeschrijving ;
  sh:property [
    sh:path dpm:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
    ui:primaryDisplayIdentifier true ;
  ] ;
  sh:property [
    sh:path dpm:legalForm ;
    sh:datatype xsd:string ;
    sh:in ( "NV" "BV" "anders" ) ;
    sh:minCount 1 ;
    sh:order 2 ;
  ] ;
  sh:property [
    sh:path dpm:otherLegalForm ;
    sh:datatype xsd:string ;
    sh:order 3 ;
    ui:enabledWhenProperty dpm:legalForm ;
    ui:enabledWhenValue "anders" ;
    ui:requiredWhenEnabled true ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path dpm:legalForm ;
        sh:in ( "NV" "BV" ) ;
      ] ;
      sh:property [
        sh:path dpm:otherLegalForm ;
        sh:maxCount 0 ;
      ] ;
    ]
    [
      sh:property [
        sh:path dpm:legalForm ;
        sh:hasValue "anders" ;
      ] ;
      sh:property [
        sh:path dpm:otherLegalForm ;
        sh:minCount 1 ;
      ] ;
    ]
  ) .

vwm:GoedBeschrijvingShape a sh:NodeShape ;
  sh:targetClass vwm:GoedBeschrijving ;
  sh:property [
    sh:path dpm:omschrijving ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:path dpm:goedsoort ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 2 ;
  ] .

vwm:PersoonOndernemingFunctieRolShape a sh:NodeShape ;
  sh:targetClass vwm:PersoonOndernemingFunctieRol ;
  sh:property [
    sh:path vwm:functieNaam ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
  ] .

vwm:VoertuigBeschrijvingShape a sh:NodeShape ;
  sh:targetClass vwm:VoertuigBeschrijving ;
  sh:property [
    sh:path dpm:brand ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 2 ;
    ui:lookupEndpoint "/api/voertuig/kenteken" ;
    ui:lookupSourceField "merk" ;
  ] ;
  sh:property [
    sh:path dpm:model ;
    sh:datatype xsd:string ;
    sh:order 3 ;
    ui:lookupEndpoint "/api/voertuig/kenteken" ;
    ui:lookupSourceField "handelsbenaming" ;
  ] ;
  sh:property [
    sh:path dpm:color ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 4 ;
    ui:lookupEndpoint "/api/voertuig/kenteken" ;
    ui:lookupSourceField "eerste_kleur" ;
  ] ;
  sh:property [
    sh:path dpm:licensePlate ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
    vwm:isIdentityKey true ;
    vwm:identityNormalizer "ALNUM_UPPER" ;
    ui:primaryDisplayIdentifier true ;
    ui:lookupEndpoint "/api/voertuig/kenteken" ;
    ui:lookupQueryParam "kenteken" ;
    ui:lookupTrigger "input" ;
    ui:lookupDebounceMs 500 ;
    ui:lookupMinLength 6 ;
  ] ;
  ui:sameIdentityActionLabel "Zelfde voertuig" ;
  ui:alreadyLinkedLabel "Al gekoppeld via Verwijzing" .

vwm:VoertuigBeschrijving vwm:isFindableInOtherCase true .
vwm:VoertuigBeschrijving vwm:searchProperty dpm:licensePlate .

vwm:IncidentToestandsWeergaveShape a sh:NodeShape ;
  sh:targetClass vwm:IncidentToestandsWeergave ;
  sh:property [
    sh:path vwm:beschrijving ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:path vwm:heeftBestand ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 2 ;
  ] .

vwm:PersoonToestandsWeergaveShape a sh:NodeShape ;
  sh:targetClass vwm:PersoonToestandsWeergave ;
  sh:property [
    sh:path vwm:beschrijving ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:path vwm:heeftBestand ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 2 ;
  ] .

vwm:PersoonSignalementShape a sh:NodeShape ;
  sh:targetClass vwm:PersoonSignalement ;
  sh:property [
    sh:path vwm:heeftBronGOIC ;
    sh:nodeKind sh:IRI ;
    sh:class vwm:GegevensObjectInContext ;
    sh:maxCount 1 ;
    sh:order 0 ;
  ] ;
  sh:property [
    sh:path dpm:estimatedGender ;
    sh:datatype xsd:string ;
    sh:in ( "Man" "Vrouw" "Onbekend" ) ;
    sh:minCount 1 ;
    sh:order 1 ;
    ui:fieldWidth "sm" ;
  ] ;
  sh:property [
    sh:path dpm:estimatedAgeMin ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:order 2 ;
    ui:fieldWidth "sm" ;
  ] ;
  sh:property [
    sh:path dpm:estimatedAgeMax ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:order 3 ;
    ui:fieldWidth "sm" ;
  ] ;
  sh:property [
    sh:path dpm:estimatedHeightCm ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:order 4 ;
    ui:fieldWidth "sm" ;
  ] ;
  sh:property [
    sh:path dpm:bodyBuild ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:order 5 ;
  ] ;
  sh:property [
    sh:path dpm:skinTone ;
    sh:datatype xsd:string ;
    sh:in ( "Licht" "Getint" "Donker" ) ;
    sh:minCount 1 ;
    sh:order 6 ;
    ui:fieldWidth "sm" ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Leeftijd van moet kleiner dan of gelijk aan leeftijd tot zijn." ;
    sh:select """
      PREFIX dpm: <http://ontologie.politie.nl/def/dpm#>
      SELECT $this
      WHERE {
        $this dpm:estimatedAgeMin ?min ;
              dpm:estimatedAgeMax ?max .
        FILTER (?min > ?max)
      }
    """ ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Actief PersoonSignalement moet een bron (heeftBronGOIC) hebben." ;
    sh:select """
      PREFIX vwm: <http://ontologie.politie.nl/def/vwm#>
      PREFIX dpm: <http://ontologie.politie.nl/def/dpm#>
      SELECT $this
      WHERE {
        FILTER NOT EXISTS { $this dpm:invalidatedAtTime ?invalidatedAt . }
        FILTER NOT EXISTS { $this vwm:heeftBronGOIC ?bronGoic . }
      }
    """ ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Bron voor PersoonSignalement moet een GOIC van een Persoon zijn." ;
    sh:select """
      PREFIX vwm: <http://ontologie.politie.nl/def/vwm#>
      PREFIX dpm: <http://ontologie.politie.nl/def/dpm#>
      SELECT $this
      WHERE {
        FILTER NOT EXISTS { $this dpm:invalidatedAtTime ?invalidatedAt . }
        $this vwm:heeftBronGOIC ?bronGoic .
        FILTER NOT EXISTS {
          ?tb vwm:beschrijftGOIC ?bronGoic ;
              a ?tbClass .
          ?tbClass vwm:beschrijftClass dpm:Person .
          FILTER NOT EXISTS { ?tb dpm:invalidatedAtTime ?invalidatedAt . }
        }
      }
    """ ;
  ] .

vwm:RolTypeBestuurderRegelShape a sh:NodeShape ;
  sh:targetNode vwm:RolType_Bestuurder ;
  vwm:rolTbClass vwm:PersoonVoertuigRol ;
  vwm:vanClass dpm:Person ;
  vwm:naarClass dpm:Vehicle ;
  vwm:vanProperty vwm:heeftPersoon ;
  vwm:naarProperty vwm:heeftVoertuig .

vwm:RolTypeEigenaarRegelShape a sh:NodeShape ;
  sh:targetNode vwm:RolType_Eigenaar ;
  vwm:rolTbClass vwm:PersoonVoertuigRol ;
  vwm:vanClass dpm:Person ;
  vwm:naarClass dpm:Vehicle ;
  vwm:vanProperty vwm:heeftPersoon ;
  vwm:naarProperty vwm:heeftVoertuig .

vwm:RolTypeAangeverRegelShape a sh:NodeShape ;
  sh:targetNode vwm:RolType_Aangever ;
  vwm:rolTbClass vwm:PersoonIncidentRol ;
  vwm:vanClass dpm:Person ;
  vwm:naarClass dpm:Incident ;
  vwm:vanProperty vwm:heeftPersoon ;
  vwm:naarProperty vwm:heeftIncident .

vwm:RolTypeGetuigeRegelShape a sh:NodeShape ;
  sh:targetNode vwm:RolType_Getuige ;
  vwm:rolTbClass vwm:PersoonIncidentRol ;
  vwm:vanClass dpm:Person ;
  vwm:naarClass dpm:Incident ;
  vwm:vanProperty vwm:heeftPersoon ;
  vwm:naarProperty vwm:heeftIncident .

vwm:RolTypeOmstanderRegelShape a sh:NodeShape ;
  sh:targetNode vwm:RolType_Omstander ;
  vwm:rolTbClass vwm:PersoonIncidentRol ;
  vwm:vanClass dpm:Person ;
  vwm:naarClass dpm:Incident ;
  vwm:vanProperty vwm:heeftPersoon ;
  vwm:naarProperty vwm:heeftIncident .

vwm:RolTypeVerdachteRegelShape a sh:NodeShape ;
  sh:targetNode vwm:RolType_Verdachte ;
  vwm:rolTbClass vwm:PersoonIncidentRol ;
  vwm:vanClass dpm:Person ;
  vwm:naarClass dpm:Incident ;
  vwm:vanProperty vwm:heeftPersoon ;
  vwm:naarProperty vwm:heeftIncident .

vwm:RolTypeFunctieRegelShape a sh:NodeShape ;
  sh:targetNode vwm:RolType_Functie ;
  vwm:rolTbClass vwm:PersoonOndernemingFunctieRol ;
  vwm:vanClass dpm:Person ;
  vwm:naarClass dpm:Onderneming ;
  vwm:vanProperty vwm:heeftPersoon ;
  vwm:naarProperty vwm:heeftOnderneming .

vwm:DossierExactOneIncidentShape a sh:NodeShape ;
  sh:targetClass vwm:Dossier ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Voor dit dossier is exact 1 actief Incident GOIC verplicht." ;
    sh:select """
      PREFIX vwm: <http://ontologie.politie.nl/def/vwm#>
      PREFIX dpm: <http://ontologie.politie.nl/def/dpm#>
      SELECT $this
      WHERE {
        $this vwm:vereistIncidentInDossier true .
        {
          SELECT $this (COUNT(DISTINCT ?goic) AS ?incidentCount)
          WHERE {
            OPTIONAL {
              ?goic vwm:hoortBijDossier $this .
              ?tb a vwm:IncidentBeschrijving ;
                  vwm:beschrijftGOIC ?goic .
              FILTER NOT EXISTS { ?tb dpm:invalidatedAtTime ?invalidatedAt . }
            }
          }
          GROUP BY $this
          HAVING (?incidentCount != 1)
        }
      }
    """ ;
  ] .

vwm:GoicDoelClassConsistencyShape a sh:NodeShape ;
  sh:targetClass vwm:GegevensObjectInContext ;
  sh:property [
    sh:path vwm:heeftDoelClass ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "GOIC met actieve kern-TB moet vwm:heeftDoelClass hebben." ;
    sh:select """
      PREFIX vwm: <http://ontologie.politie.nl/def/vwm#>
      PREFIX dpm: <http://ontologie.politie.nl/def/dpm#>
      SELECT $this
      WHERE {
        FILTER EXISTS {
          ?tb vwm:beschrijftGOIC $this ;
              a ?tbClass .
          ?tbClass vwm:beschrijftClass ?expectedClass .
          FILTER NOT EXISTS { ?tb dpm:invalidatedAtTime ?invalidatedAt . }
          FILTER EXISTS { ?tbClass <http://www.w3.org/2000/01/rdf-schema#subClassOf>* vwm:Kern . }
        }
        FILTER NOT EXISTS { $this vwm:heeftDoelClass ?doelClass . }
      }
    """ ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "vwm:heeftDoelClass op GOIC moet overeenkomen met actieve kern-TB class." ;
    sh:select """
      PREFIX vwm: <http://ontologie.politie.nl/def/vwm#>
      PREFIX dpm: <http://ontologie.politie.nl/def/dpm#>
      SELECT DISTINCT $this
      WHERE {
        ?tb vwm:beschrijftGOIC $this ;
            a ?tbClass .
        ?tbClass vwm:beschrijftClass ?expectedClass .
        $this vwm:heeftDoelClass ?actualClass .
        FILTER NOT EXISTS { ?tb dpm:invalidatedAtTime ?invalidatedAt . }
        FILTER EXISTS { ?tbClass <http://www.w3.org/2000/01/rdf-schema#subClassOf>* vwm:Kern . }
        FILTER (?actualClass != ?expectedClass)
      }
    """ ;
  ] .
